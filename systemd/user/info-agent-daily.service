[Unit]
Description=Info Agent daily RSS collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/info-agent
EnvironmentFile=-%h/.config/info-agent/email.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/projects/info-agent/scripts/run_daily.sh
