[Unit]
Description=Info Agent daily RSS collection
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/M-Digest
EnvironmentFile=-%h/.config/info-agent/email.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Projects/M-Digest/scripts/run_daily.sh
